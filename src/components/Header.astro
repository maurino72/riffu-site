---
import { getRelativeLocaleUrl } from 'astro:i18n';
import wordmark from '../assets/brand/wordmark-violet.svg';
import { APP_STORE_URL } from '../config';
import { t, type Locale } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
---

<header class="header">
  <div class="container inner">
    <a class="brand" href={getRelativeLocaleUrl(locale, '/')} aria-label={s.home}>
      <img src={wordmark.src} width="84" height="48" alt="" />
    </a>
    <div class="actions">
      <LanguageSwitcher locale={locale} path={path} compact />
      <a class="button download" href={APP_STORE_URL} aria-label={s.downloadLabel}>
        {s.download}
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.94);
    border-bottom: 1px solid var(--border);
  }

  @supports (backdrop-filter: blur(8px)) {
    .header {
      background: rgb(255 255 255 / 0.8);
      backdrop-filter: blur(8px);
    }
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: var(--header-height);
  }

  .brand {
    display: block;
    flex-shrink: 0;
  }

  .brand img {
    width: 84px;
    height: auto;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .download {
    min-height: 2.25rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.9375rem;
  }
</style>
