---
import { getRelativeLocaleUrl } from 'astro:i18n';
import lockup from '../assets/brand/lockup-violet.svg';
import { COMPANY } from '../config';
import { t, type Locale } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
const year = new Date().getFullYear();
const links = [
  { path: '/terms', label: s.terms },
  { path: '/privacy', label: s.privacy },
  { path: '/delete-account', label: s.deleteAccount },
  { path: '/support', label: s.support },
];
---

<footer class="footer">
  <div class="container inner">
    <img class="lockup" src={lockup.src} width={lockup.width} height={lockup.height} alt="Riffu" />
    <nav aria-label={s.legalNav}>
      <ul class="links">
        {links.map((link) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, link.path)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSwitcher locale={locale} path={path} />
    <p class="legal">
      {`© ${year} ${COMPANY.name}. ${s.rights}`}
      <br />
      {s.appleTrademark}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding-block: 2.5rem;
    background: var(--surface-muted);
    border-top: 1px solid var(--border);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--ink);
    font-weight: 800;
  }

  .lockup {
    width: 160px;
    height: auto;
  }

  .legal {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
