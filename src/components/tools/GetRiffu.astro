---
/** The "Get Riffu" banner under every tool: the pitch and the App Store badge. */
import { tools } from '../../i18n/tools';
import type { Locale } from '../../i18n/ui';
import AppStoreDownload from '../AppStoreDownload.astro';
import melo from '../../assets/melo/sing.svg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = tools[locale].banner;
---

<aside class="banner" aria-labelledby="get-riffu">
  <img src={melo.src} width="96" height="96" alt="" loading="lazy" />
  <div class="copy">
    <h2 id="get-riffu">{s.heading}</h2>
    <p>{s.text}</p>
    <AppStoreDownload locale={locale} qr={false} />
  </div>
</aside>

<style>
  .banner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: 24px;
    background: var(--violet-tint);
  }

  img {
    flex-shrink: 0;
    width: 96px;
    height: auto;
  }

  h2 {
    font-size: 1.5rem;
  }

  p {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 560px) {
    .banner {
      flex-direction: column;
      text-align: center;
    }

    .copy :global(.download) {
      justify-content: center;
    }
  }
</style>
