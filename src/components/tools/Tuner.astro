---
/**
 * The tuner. The page is complete HTML; the script (`src/scripts/tuner.ts`) is only loaded here,
 * and the microphone is asked for only when the visitor taps Start.
 */
import { INSTRUMENTS, type Instrument } from '../../lib/notes';
import { tools } from '../../i18n/tools';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  instrument: Instrument;
}

const { locale, instrument } = Astro.props;
const s = tools[locale];
const ui = s.tunerUi;
const config = { locale, ui };
---

<section class="tuner" data-tuner data-config={JSON.stringify(config)} aria-label={s.tuner}>
  <div class="controls">
    <label>
      <span>{ui.instrument}</span>
      <select data-instrument>
        {INSTRUMENTS.map((i) => (
          <option value={i} selected={i === instrument}>
            {s.instrumentNames[i]}
          </option>
        ))}
      </select>
    </label>
    <label>
      <span>{ui.reference}</span>
      <select data-reference>
        {[438, 439, 440, 441, 442, 443].map((hz) => (
          <option value={hz} selected={hz === 440}>
            {hz} Hz
          </option>
        ))}
      </select>
    </label>
  </div>

  <div class="display" data-display>
    <p class="read">
      <span class="label">{ui.writtenLabel}</span>
      <span class="note" data-written>
        –
      </span>
    </p>
    <div class="meter" aria-hidden="true">
      <span class="zone"></span>
      <span class="needle" data-needle></span>
    </div>
    <p class="verdict">
      <span data-verdict>{ui.nothing}</span> <span class="cents" data-cents></span>
    </p>
    <p class="concert">
      <span class="label">{ui.concertLabel}</span>
      <span data-concert>–</span>
    </p>
  </div>

  <button class="button start" type="button" data-start disabled>
    {ui.start}
  </button>
  <p class="status" role="status" data-status hidden></p>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
  <noscript>
    <p class="status">{ui.noscript}</p>
  </noscript>
</section>

<script>
  import { initTuner } from '../../scripts/tuner';
  document.querySelectorAll<HTMLElement>('[data-tuner]').forEach(initTuner);
</script>

<style>
  .tuner {
    max-width: 30rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 2px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 4px 0 var(--border);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--text-muted);
  }

  select {
    min-height: 2.5rem;
    padding: 0.375rem 0.625rem;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 800;
  }

  .display {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .label {
    display: block;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--text-muted);
  }

  .read {
    margin: 0;
  }

  .note {
    display: block;
    font-size: clamp(3.5rem, 18vw, 5.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--ink);
  }

  .meter {
    position: relative;
    height: 1.25rem;
    margin: 0.5rem 0.5rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--surface-muted);
    border: 2px solid var(--border);
  }

  /* The in-tune zone: within 5 cents of the middle, out of a 50-cent half-width. */
  .zone {
    position: absolute;
    inset-block: 0;
    left: 45%;
    width: 10%;
    background: var(--violet-light);
  }

  .needle {
    position: absolute;
    top: -0.375rem;
    bottom: -0.375rem;
    left: 50%;
    width: 0.375rem;
    margin-left: -0.1875rem;
    border-radius: var(--radius-pill);
    background: var(--text-muted);
    opacity: 0.35;
    transition: left 120ms linear;
  }

  .display[data-state='live'] .needle {
    opacity: 1;
    background: var(--violet);
  }

  .display[data-state='tuned'] .needle {
    opacity: 1;
    background: var(--brass);
  }

  .verdict {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--ink);
  }

  .cents {
    font-weight: 600;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .concert {
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--ink);
  }

  .concert .label {
    display: inline;
    margin-right: 0.25rem;
  }

  .start {
    width: 100%;
    min-height: 3rem;
    border: 0;
    font: inherit;
    font-weight: 900;
    font-size: 1.125rem;
    cursor: pointer;
  }

  .start:disabled {
    background: var(--border);
    color: var(--text-muted);
    box-shadow: none;
    cursor: not-allowed;
  }

  .status {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }

  .status[data-kind='error'] {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--surface-muted);
    border-left: 4px solid var(--brass);
    color: var(--ink);
  }
</style>
