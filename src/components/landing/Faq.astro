---
import { landing } from '../../i18n/landing';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const s = landing[Astro.props.locale].faq;
---

<section class="section" aria-labelledby="faq-heading">
  <div class="container narrow">
    <h2 id="faq-heading">{s.heading}</h2>
    {s.items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .narrow {
    max-width: 48rem;
  }

  details {
    border-bottom: 2px solid var(--border);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0;
    cursor: pointer;
    font-weight: 800;
    color: var(--ink);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex-shrink: 0;
    font-weight: 900;
    font-size: 1.375rem;
    line-height: 1;
    color: var(--violet);
  }

  details[open] summary::after {
    content: '−';
  }

  p {
    padding-bottom: 1.125rem;
    margin: 0;
  }
</style>
