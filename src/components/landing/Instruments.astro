---
import sing from '../../assets/melo/sing.svg';
import { landing } from '../../i18n/landing';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const s = landing[Astro.props.locale].instruments;
---

<section class="section instruments" aria-labelledby="instruments-heading">
  <div class="container inner">
    <img class="melo" src={sing.src} width="120" height="133" alt="" />
    <div>
      <h2 id="instruments-heading">{s.heading}</h2>
      <p>{s.text}</p>
      <ul>
        {s.list.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .melo {
    width: 120px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 2px solid var(--violet);
    color: var(--violet-dark);
    font-weight: 800;
  }

  @media (min-width: 760px) {
    .inner {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
    }
  }
</style>
