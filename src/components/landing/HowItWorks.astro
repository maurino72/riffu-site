---
import { landing } from '../../i18n/landing';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const s = landing[Astro.props.locale].how;
---

<section class="section how" aria-labelledby="how-heading">
  <div class="container">
    <h2 id="how-heading">{s.heading}</h2>
    <ol class="steps">
      {s.steps.map((step, i) => (
        <li>
          <span class="number" aria-hidden="true">
            {i + 1}
          </span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 1.5rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .number {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--violet);
    color: var(--on-violet);
    font-weight: 900;
    font-size: 1.125rem;
  }

  p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
