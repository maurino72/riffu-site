---
import { landing } from '../../i18n/landing';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const s = landing[Astro.props.locale].how;

// One small drawing per step: the tuner's dial, notes on a staff, and a right answer.
const icons = [
  '<path d="M6 30a18 18 0 0 1 36 0" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><path d="M24 30 31 15" stroke="#F2B441" stroke-width="4" stroke-linecap="round"/><circle cx="24" cy="30" r="4" fill="currentColor"/>',
  '<g stroke="currentColor" stroke-width="2"><path d="M4 14h40M4 21h40M4 28h40M4 35h40"/></g><ellipse cx="16" cy="28" rx="5" ry="4" fill="currentColor"/><path d="M21 28V10" stroke="currentColor" stroke-width="3"/><ellipse cx="32" cy="21" rx="5" ry="4" fill="#F2B441"/><path d="M37 21V5" stroke="#F2B441" stroke-width="3"/>',
  '<circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="4"/><path d="m15 25 6 6 13-14" fill="none" stroke="#F2B441" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>',
];
---

<section class="section how" aria-labelledby="how-heading">
  <div class="container">
    <h2 id="how-heading">{s.heading}</h2>
    <ol class="steps">
      {s.steps.map((step, i) => (
        <li>
          <div class="top" aria-hidden="true">
            <span class="number">{i + 1}</span>
            <svg class="icon" viewBox="0 0 48 48" width="48" height="48" set:html={icons[i]} />
          </div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 1.5rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .icon {
    width: 48px;
    height: 48px;
    color: var(--violet);
  }

  .number {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--violet);
    color: var(--on-violet);
    font-weight: 900;
    font-size: 1.125rem;
  }

  p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
