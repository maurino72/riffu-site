---
/**
 * Apple's official "Download on the App Store" badge, unmodified, and on desktop a QR code that
 * opens the same App Store page on an iPhone. The QR is drawn at build time: no third-party
 * service, no JavaScript.
 */
import QRCode from 'qrcode';
import badgeEn from '../assets/badges/app-store-en.svg';
import badgeEs from '../assets/badges/app-store-es.svg';
import { APP_STORE_URL } from '../config';
import { landing } from '../i18n/landing';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Show the QR code beside the badge on wide screens. */
  qr?: boolean;
}

const { locale, qr = true } = Astro.props;
const s = landing[locale];
const badge = locale === 'es' ? badgeEs : badgeEn;
const qrSvg = qr
  ? await QRCode.toString(APP_STORE_URL, {
      type: 'svg',
      margin: 0,
      errorCorrectionLevel: 'M',
      color: { dark: '#2B1458', light: '#FFFFFF' },
    })
  : '';
---

<div class="download">
  <a class="badge" href={APP_STORE_URL}>
    <img src={badge.src} width="150" height="50" alt={s.badgeAlt} />
  </a>
  {qr && (
    <figure class="qr">
      <div class="qr-code" role="img" aria-label={s.qrCaption} set:html={qrSvg} />
      <figcaption>{s.qrCaption}</figcaption>
    </figure>
  )}
</div>

<style>
  .download {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Apple's rules: at least 40 px tall onscreen, clear space of a quarter of the height. */
  .badge {
    display: block;
    padding: 12px;
    margin: -12px;
    border-radius: 12px;
  }

  .badge img {
    width: 150px;
    height: 50px;
  }

  .qr {
    display: none;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .qr-code {
    width: 88px;
    height: 88px;
    padding: 6px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .qr-code :global(svg) {
    width: 100%;
    height: 100%;
  }

  figcaption {
    max-width: 9rem;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .qr {
      display: flex;
    }
  }
</style>
