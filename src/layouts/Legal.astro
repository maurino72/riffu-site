---
/** A legal or help page: the shared layout, one heading, the "Last updated" line and prose. */
import { LEGAL_UPDATED } from '../config';
import type { Locale } from '../i18n/ui';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  /** Show the "Last updated" line (the Support page does not need it). */
  dated?: boolean;
}

const { locale, path, title, description, dated = true } = Astro.props;
const date = new Date(`${LEGAL_UPDATED}T12:00:00Z`).toLocaleDateString(
  locale === 'es' ? 'es' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
);
const updated = locale === 'es' ? `Última actualización: ${date}` : `Last updated: ${date}`;
---

<Base locale={locale} path={path} title={`${title} · Riffu`} description={description}>
  <article class="container prose">
    <h1>{title}</h1>
    {dated && <p class="updated">{updated}</p>}
    <slot />
  </article>
</Base>

<style>
  .prose {
    max-width: 46rem;
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .updated {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 2rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.25rem;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    margin-top: 1.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    margin: 0 0 1em;
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose :global(address) {
    font-style: normal;
  }
</style>
